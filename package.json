{
  "name": "linear-slack-sections",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local Linear status reconciliation for personal Slack sections",
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "start": "bun src/cli.ts",
    "demo": "bun src/cli.ts --config config.example.json --fixture fixtures/demo.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build": "bun build src/cli.ts --target bun --outdir dist",
    "check": "bun run typecheck && bun run lint && bun test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@types/bun": "1.3.0",
    "typescript": "5.9.3"
  }
}
